/**
 * DAPENG Alpha 策略选股系统 - API 请求封装 v3
 *
 * 优化点：
 * - 请求去重：同一 URL 的并发请求只发一次
 * - AbortController：切换板块/股票时取消未完成的请求
 * - 超时控制：防止请求无限挂起
 * - 智能刷新：盘后降低刷新频率
 */

const API_BASE = '';  // 同源，无需前缀

// ================================================================
//  工具函数
// ================================================================

/**
 * HTML 转义 — 防止 XSS，所有用户数据插入 DOM 前必须转义
 */
function escapeHtml(text) {
  if (text == null) return '';
  const div = document.createElement('div');
  div.textContent = String(text);
  return div.innerHTML;
}

/**
 * 安全 JSON 解析 — 数据损坏时返回默认值，不抛异常
 */
function safeJsonParse(raw, fallback) {
  try { return JSON.parse(raw); }
  catch { return fallback; }
}

/**
 * 安全 toFixed — 处理 null/undefined
 */
function safeFixed(val, digits) {
  if (val == null || isNaN(val)) return '--';
  return Number(val).toFixed(digits || 2);
}

const API = {
  quotes: (sector, fast) => `${API_BASE}/api/quotes?sector=${encodeURIComponent(sector || 'semiconductor')}${fast ? '&fast=1' : ''}`,
  kline: (code, period) => `${API_BASE}/api/kline?code=${encodeURIComponent(code)}&period=${encodeURIComponent(period || 'day')}`,
  global: `${API_BASE}/api/global`,
  search: (keyword) => `${API_BASE}/api/search?keyword=${encodeURIComponent(keyword)}`,
  screen: (minScore, minChg, sector, limit) => {
    let url = `${API_BASE}/api/screen?min_score=${minScore || 70}&limit=${limit || 20}`;
    if (minChg !== undefined && minChg !== null) url += `&min_chg=${minChg}`;
    if (sector) url += `&sector=${encodeURIComponent(sector)}`;
    return url;
  },
  health: `${API_BASE}/api/health`,
  analyze: (code) => `${API_BASE}/api/analyze?code=${encodeURIComponent(code)}`,
  scan: `${API_BASE}/api/scan`,
  realtime: (codes) => `${API_BASE}/api/realtime?codes=${encodeURIComponent(codes)}`,
};

// ================================================================
//  请求去重 + 超时控制 + K线请求取消 + sessionStorage 缓存
// ================================================================
const _pendingRequests = new Map();
let _klineAbortController = null;
const KLINE_CACHE_TTL = 5 * 60 * 1000; // 5 分钟

/**
 * 取消当前正在进行的K线请求
 */
function cancelPendingKline() {
  if (_klineAbortController) {
    _klineAbortController.abort();
    _klineAbortController = null;
  }
}

/**
 * 从 sessionStorage 读取 K 线缓存
 */
function _getKlineCache(key) {
  try {
    const raw = sessionStorage.getItem('kl_' + key);
    if (!raw) return null;
    const entry = JSON.parse(raw);
    if (Date.now() - entry.ts > KLINE_CACHE_TTL) {
      sessionStorage.removeItem('kl_' + key);
      return null;
    }
    return entry.data;
  } catch { return null; }
}

/**
 * 写入 K 线缓存到 sessionStorage
 */
function _setKlineCache(key, data) {
  try {
    sessionStorage.setItem('kl_' + key, JSON.stringify({ data, ts: Date.now() }));
  } catch { /* storage full, ignore */ }
}

/**
 * 通用请求封装
 * - 同 URL 并发请求去重
 * - 超时控制（默认 15 秒）
 * - 请求失败静默降级
 */
async function request(url, options = {}) {
  const timeout = options.timeout || 15000;

  // 请求去重：如果同一 URL 有正在进行的请求，复用 Promise
  if (_pendingRequests.has(url)) {
    return _pendingRequests.get(url);
  }

  const promise = _doRequest(url, options, timeout);
  _pendingRequests.set(url, promise);

  try {
    const result = await promise;
    return result;
  } finally {
    _pendingRequests.delete(url);
  }
}

async function _doRequest(url, options, timeout) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeout);

  try {
    const response = await fetch(url, {
      ...options,
      signal: controller.signal,
      headers: {
        'Content-Type': 'application/json',
        ...options.headers,
      },
    });

    if (!response.ok) {
      console.warn(`API HTTP error: ${response.status} ${url}`);
      return null;
    }

    const json = await response.json();

    if (!json.ok) {
      console.warn(`API business error: ${json.message || 'unknown'} ${url}`);
      return null;
    }

    return json.data;
  } catch (e) {
    if (e.name === 'AbortError') {
      console.warn(`API timeout: ${url}`);
    } else {
      console.warn(`API request error: ${url}`, e);
    }
    return null;
  } finally {
    clearTimeout(timer);
  }
}

// ================================================================
//  业务 API 封装
// ================================================================

/**
 * 获取板块行情数据
 * @param {string} sector - 板块key
 * @param {boolean} fast - 快速模式：只取行情不等K线策略（首屏加速用）
 */
async function fetchQuotes(sector, fast) {
  return request(API.quotes(sector, fast));
}

/**
 * 获取 K 线数据 — 支持请求取消 + sessionStorage 缓存
 */
async function fetchKline(code, period) {
  // 先检查 sessionStorage 缓存
  const cacheKey = `${code}:${period}`;
  const cached = _getKlineCache(cacheKey);
  if (cached) return cached;

  // 每次请求K线时创建新的 AbortController
  cancelPendingKline();
  _klineAbortController = new AbortController();
  const controller = _klineAbortController;
  const url = API.kline(code, period);

  const timeout = 15000;  // K线超时15秒

  try {
    const timer = setTimeout(() => controller.abort(), timeout);
    const response = await fetch(url, {
      signal: controller.signal,
      headers: { 'Content-Type': 'application/json' },
    });
    clearTimeout(timer);

    if (!response.ok) {
      console.warn(`K线 API HTTP error: ${response.status}`);
      return null;
    }

    const json = await response.json();
    if (!json.ok) {
      console.warn(`K线 API business error: ${json.message || 'unknown'}`);
      return null;
    }

    // 写入缓存
    if (json.data) _setKlineCache(cacheKey, json.data);
    return json.data;
  } catch (e) {
    if (e.name === 'AbortError') {
      console.log(`K线请求已取消: ${code}`);
    } else {
      console.warn(`K线请求错误: ${code}`, e);
    }
    return null;
  } finally {
    if (_klineAbortController === controller) {
      _klineAbortController = null;
    }
  }
}

/**
 * 获取全球市场数据
 */
async function fetchGlobal() {
  return request(API.global);
}

/**
 * 搜索股票（跨板块）
 */
async function fetchSearch(keyword) {
  return request(API.search(keyword), { timeout: 10000 });
}

/**
 * 条件选股
 */
async function fetchScreen(minScore, minChg, sector, limit) {
  return request(API.screen(minScore, minChg, sector, limit), { timeout: 40000 });
}

/**
 * 获取实时分析总结 — 带版本号校验
 */
async function fetchAnalyze(code, version) {
  return request(API.analyze(code), { timeout: 12000 });
}

/**
 * 全市场智能选股扫描
 */
async function fetchScan() {
  // 首次请求触发扫描（可能返回 pending 状态）
  let resp = await request(API.scan, { timeout: 10000 });
  if (!resp) return null;

  // 如果扫描完成，直接返回数据
  if (!resp.pending || resp.data) return resp;

  // 轮询等待扫描完成，每2秒查询一次，最多等90秒
  const maxWait = 90000;
  const pollInterval = 2000;
  const startTime = Date.now();

  while (Date.now() - startTime < maxWait) {
    await new Promise(r => setTimeout(r, pollInterval));
    resp = await request(API.scan, { timeout: 10000 });
    if (!resp) return null;
    if (!resp.pending || resp.data) return resp;
  }

  return null; // 超时
}

/**
 * 健康检查
 */
async function fetchHealth() {
  return request(API.health, { timeout: 5000 });
}

/**
 * 腾讯实时行情
 */
async function fetchRealtime(codes) {
  if (!codes || codes.length === 0) return null;
  return request(API.realtime(codes.join(',')), { timeout: 4000 });
}

// ================================================================
//  智能刷新间隔
// ================================================================

/**
 * 判断是否在交易时间（A 股 9:30-15:00 工作日）
 */
function isTradingHours() {
  const now = new Date();
  const day = now.getDay();
  const h = now.getHours();
  const m = now.getMinutes();
  const timeVal = h * 100 + m;

  // 周末
  if (day === 0 || day === 6) return false;
  // 9:30 - 11:30 或 13:00 - 15:00
  if ((timeVal >= 930 && timeVal <= 1130) || (timeVal >= 1300 && timeVal <= 1500)) {
    return true;
  }
  return false;
}

/**
 * 获取推荐的刷新间隔（毫秒）
 */
function getSmartRefreshInterval() {
  return isTradingHours() ? 30000 : 120000;  // 盘中30秒，盘后2分钟
}
/**
 * DAPENG Alpha v4 — ECharts 渲染引擎
 * BOLL + RSI + BBI + EMA + 分时图 + 高级 tooltip
 */
let klineChart = null;
let chartType = 'kline';
let _chartInitTries = 0;

function initChart() {
  const el = document.getElementById('kline-chart');
  if (!el) return;

  // 确保容器有高度（flex布局有时初始高度为0）
  if (el.clientHeight === 0) {
    el.style.height = '380px';
  }

  if (typeof echarts === 'undefined') {
    _chartInitTries++;
    if (_chartInitTries < 20) {
      // 每300ms重试，最多6秒
      setTimeout(initChart, 300);
    } else {
      console.error('[DAPENG] ECharts 加载超时，K线图不可用');
    }
    return;
  }

  // 已经初始化过
  if (klineChart && !klineChart.isDisposed()) return;

  try {
    klineChart = echarts.init(el, null, { renderer: 'canvas' });
    _chartInitTries = 0;
    window.addEventListener('resize', () => {
      if (klineChart && !klineChart.isDisposed()) klineChart.resize();
    });
    // 通知 app.js 图表已就绪
    if (typeof window._onChartReady === 'function') {
      window._onChartReady();
    }
  } catch (e) {
    console.error('[DAPENG] ECharts 初始化失败:', e);
  }
}

function calcEMA(data, period) {
  if (!data || data.length < period) return [];
  const k = 2 / (period + 1), res = [];
  let ema = data[0]; res.push(ema);
  for (let i = 1; i < data.length; i++) { ema = data[i] * k + ema * (1 - k); res.push(ema); }
  return res;
}

function calcMA(data, period) {
  if (!data || data.length < period) return [];
  const res = [];
  for (let i = 0; i < data.length; i++) {
    if (i < period - 1) { res.push(null); continue; }
    let s = 0; for (let j = i - period + 1; j <= i; j++) s += data[j];
    res.push(s / period);
  }
  return res;
}

function calcBOLL(closes, period = 20, mult = 2) {
  if (!closes || closes.length < period) return { upper: [], mid: [], lower: [], width: [] };
  const up = [], mid = [], lo = [], w = [];
  for (let i = 0; i < closes.length; i++) {
    if (i < period - 1) { up.push(null); mid.push(null); lo.push(null); w.push(null); continue; }
    const slice = closes.slice(i - period + 1, i + 1);
    const sma = slice.reduce((a, b) => a + b, 0) / period;
    const std = Math.sqrt(slice.reduce((s, v) => s + (v - sma) ** 2, 0) / period);
    mid.push(sma); up.push(sma + mult * std); lo.push(sma - mult * std);
    w.push((2 * mult * std / sma * 100));
  }
  return { upper: up, mid, lower: lo, width: w };
}

function calcRSI(closes, period = 14) {
  if (!closes || closes.length < period + 1) return [];
  const rsi = [];
  for (let i = 0; i < closes.length; i++) {
    if (i < period) { rsi.push(null); continue; }
    let g = 0, l = 0;
    for (let j = i - period + 1; j <= i; j++) {
      const d = closes[j] - closes[j - 1];
      d > 0 ? (g += d) : (l += Math.abs(d));
    }
    g /= period; l /= period;
    rsi.push(l === 0 ? 100 : 100 - 100 / (1 + g / l));
  }
  return rsi;
}

function calcBBI(closes) {
  if (!closes || closes.length < 24) return [];
  const ma3 = calcMA(closes, 3), ma6 = calcMA(closes, 6), ma12 = calcMA(closes, 12), ma24 = calcMA(closes, 24);
  const bbi = [];
  for (let i = 0; i < closes.length; i++) {
    if (!ma3[i] || !ma6[i] || !ma12[i] || !ma24[i]) { bbi.push(null); continue; }
    bbi.push((ma3[i] + ma6[i] + ma12[i] + ma24[i]) / 4);
  }
  return bbi;
}

function renderMinute(data) {
  if (!klineChart || klineChart.isDisposed()) return;
  chartType = 'minute';
  if (!data || !data.klines || !data.klines.length) { klineChart.clear(); return; }
  const kls = data.klines;
  const dates = kls.map(k => k.d);
  const prices = kls.map(k => k.c);
  const vols = kls.map(k => k.v);
  const avgP = kls.map(k => k.avg || 0);
  const yc = data.yclose || prices[0];
  klineChart.setOption({
    backgroundColor: 'transparent', animation: true, animationDuration: 500,
    tooltip: {
      trigger: 'axis', axisPointer: { type: 'cross' },
      backgroundColor: 'rgba(6,12,28,0.96)', borderColor: 'rgba(59,130,246,0.25)', borderWidth: 1,
      padding: [10, 14], textStyle: { color: '#e2e8f0', fontSize: 11 },
      extraCssText: 'border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,0.5);backdrop-filter:blur(12px)',
    },
    grid: [{ left: 54, right: 14, top: 8, height: '55%' }, { left: 54, right: 14, top: '68%', height: '18%' }],
    xAxis: [
      { gridIndex: 0, data: dates, axisLabel: { show: false }, axisLine: { lineStyle: { color: 'rgba(59,130,246,0.06)' } } },
      { gridIndex: 1, data: dates, axisLabel: { color: '#3d5278', fontSize: 9 }, axisLine: { lineStyle: { color: 'rgba(59,130,246,0.06)' } } },
    ],
    yAxis: [
      { scale: true, gridIndex: 0, axisLabel: { color: '#3d5278', fontSize: 9, formatter: v => v.toFixed(2) }, splitLine: { lineStyle: { color: 'rgba(59,130,246,0.04)', type: 'dashed' } } },
      { scale: true, gridIndex: 1, axisLabel: { color: '#3d5278', fontSize: 8 }, splitLine: { show: false } },
    ],
    dataZoom: [
      { type: 'inside', xAxisIndex: [0, 1], start: 0, end: 100 },
      { type: 'slider', xAxisIndex: [0, 1], bottom: 2, height: 14, start: 0, end: 100, backgroundColor: 'rgba(6,12,28,0.5)', borderColor: 'rgba(59,130,246,0.08)', fillerColor: 'rgba(59,130,246,0.04)', handleStyle: { color: '#3b82f6' }, textStyle: { color: '#3d5278', fontSize: 8 } },
    ],
    series: [
      { name: '价格', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: prices, symbol: 'none',
        lineStyle: { width: 1.5, color: '#3b82f6' },
        areaStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: 'rgba(59,130,246,0.25)' }, { offset: 1, color: 'rgba(59,130,246,0.02)' }]) },
        markLine: { silent: true, symbol: 'none', lineStyle: { color: 'rgba(255,255,255,0.12)', type: 'dashed' }, data: [{ yAxis: yc, label: { formatter: '昨收 {c}', color: '#8b9ec2', fontSize: 9 } }] },
      },
      { name: '均价', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: avgP, symbol: 'none', lineStyle: { width: 1, color: '#f59e0b', type: 'dashed' } },
      { name: '成交量', type: 'bar', xAxisIndex: 1, yAxisIndex: 1, data: vols.map(v => ({ value: v, itemStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: 'rgba(59,130,246,0.5)' }, { offset: 1, color: 'rgba(59,130,246,0.1)' }]) } })), barMaxWidth: 4 },
    ],
  }, { notMerge: true, lazyUpdate: false });
}

function renderKline(data) {
  if (!klineChart) { initChart(); if (!klineChart) return; }
  if (klineChart.isDisposed()) { initChart(); if (!klineChart) return; }
  chartType = 'kline';
  if (!data || !data.klines || !data.klines.length) { klineChart.clear(); return; }

  const kls = data.klines;
  const maData = data.ma || {};
  const macdData = data.macd || {};
  const dates = kls.map(k => k.d);
  const candles = kls.map(k => [k.o, k.c, k.l, k.h]);
  const closes = kls.map(k => k.c);
  const volumes = kls.map(k => ({
    value: k.v,
    itemStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
      { offset: 0, color: k.c >= k.o ? 'rgba(0,233,106,0.55)' : 'rgba(255,61,106,0.55)' },
      { offset: 1, color: k.c >= k.o ? 'rgba(0,233,106,0.1)' : 'rgba(255,61,106,0.1)' },
    ]) },
  }));

  const ma5 = (maData.ma5 || []).map(v => v > 0 ? +v.toFixed(2) : null);
  const ma10 = (maData.ma10 || []).map(v => v > 0 ? +v.toFixed(2) : null);
  const ma20 = (maData.ma20 || []).map(v => v > 0 ? +v.toFixed(2) : null);
  const ma60 = (maData.ma60 || []).map(v => v > 0 ? +v.toFixed(2) : null);
  const ema12 = calcEMA(closes, 12), ema26 = calcEMA(closes, 26);
  const boll = calcBOLL(closes, 20, 2);
  const bbi = calcBBI(closes);
  const rsi14 = calcRSI(closes, 14);
  const dif = macdData.dif || [], dea = macdData.dea || [], hist = macdData.hist || [];
  const vol5 = calcMA(volumes.map(v => v.value), 5);
  const vol10 = calcMA(volumes.map(v => v.value), 10);

  klineChart.setOption({
    backgroundColor: 'transparent', animation: true, animationDuration: 600, animationEasing: 'cubicOut',
    title: [{ text: data.adjusted !== false ? '前复权' : '不复权', left: 8, bottom: 4, textStyle: { color: 'rgba(61,82,120,0.4)', fontSize: 9 } }],
    tooltip: {
      trigger: 'axis', axisPointer: { type: 'cross', crossStyle: { color: 'rgba(99,155,255,0.25)' }, lineStyle: { color: 'rgba(99,155,255,0.12)', type: 'dashed' } },
      backgroundColor: 'rgba(6,12,28,0.98)', borderColor: 'rgba(59,130,246,0.3)', borderWidth: 1,
      extraCssText: 'border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,0.6);backdrop-filter:blur(16px)',
      formatter: function(ps) {
        const k = ps.find(p => p.seriesName === 'K线'); if (!k) return '';
        const [o, c, l, h] = k.value, idx = k.dataIndex;
        const chg = o !== 0 ? ((c - o) / o * 100).toFixed(2) : '0.00';
        const clr = c >= o ? '#00e96a' : '#ff3d6a';
        const v = volumes[idx] ? volumes[idx].value : 0;
        let html = '<div style="min-width:200px">' +
          '<div style="color:#8b9ec2;margin-bottom:6px;font-size:10px;letter-spacing:.5px">' + k.name + '</div>' +
          '<div style="display:grid;grid-template-columns:1fr 1fr;gap:2px 16px">' +
          '<span style="color:#8b9ec2">开盘</span><span>' + o.toFixed(2) + '</span>' +
          '<span style="color:#8b9ec2">收盘</span><span style="color:' + clr + ';font-weight:700">' + c.toFixed(2) + '</span>' +
          '<span style="color:#8b9ec2">最高</span><span style="color:#00e96a">' + h.toFixed(2) + '</span>' +
          '<span style="color:#8b9ec2">最低</span><span style="color:#ff3d6a">' + l.toFixed(2) + '</span>' +
          '<span style="color:#8b9ec2">成交量</span><span>' + (v / 10000).toFixed(0) + '万手</span>' +
          '<span style="color:#8b9ec2">涨跌</span><span style="color:' + clr + ';font-weight:700">' + (c >= o ? '▲ ' : '▼ ') + (chg > 0 ? '+' : '') + chg + '%</span>' +
          '</div>';
        if (ma5[idx] || ma10[idx] || ma20[idx]) html += '<div style="border-top:1px solid rgba(255,255,255,0.05);margin-top:5px;padding-top:5px;display:flex;gap:12px;font-size:10px">' +
          (ma5[idx] != null ? '<span><span style="color:#f59e0b">MA5</span> ' + ma5[idx].toFixed(2) + '</span>' : '') +
          (ma10[idx] != null ? '<span><span style="color:#3b82f6">MA10</span> ' + ma10[idx].toFixed(2) + '</span>' : '') +
          (ma20[idx] != null ? '<span><span style="color:#a855f7">MA20</span> ' + ma20[idx].toFixed(2) + '</span>' : '') + '</div>';
        if (boll.mid[idx] != null) html += '<div style="display:flex;gap:12px;font-size:10px;margin-top:2px">' +
          '<span style="color:#ff3d6a">上轨 ' + boll.upper[idx].toFixed(2) + '</span>' +
          '<span style="color:#8b9ec2">中轨 ' + boll.mid[idx].toFixed(2) + '</span>' +
          '<span style="color:#00e96a">下轨 ' + boll.lower[idx].toFixed(2) + '</span></div>';
        if (rsi14[idx] != null) { var rc = rsi14[idx] > 70 ? '#ff3d6a' : rsi14[idx] < 30 ? '#00e96a' : '#8b9ec2'; html += '<div style="font-size:10px;margin-top:2px"><span style="color:#8b9ec2">RSI(14)</span> <span style="color:' + rc + ';font-weight:600">' + rsi14[idx].toFixed(1) + '</span></div>'; }
        html += '</div>'; return html;
      },
    },
    axisPointer: { link: [{ xAxisIndex: 'all' }] },
    dataZoom: [
      { type: 'inside', xAxisIndex: [0, 1, 2, 3], start: 50, end: 100 },
      { type: 'slider', xAxisIndex: [0, 1, 2, 3], bottom: 2, height: 18, start: 50, end: 100, backgroundColor: 'rgba(6,12,28,0.5)', borderColor: 'rgba(59,130,246,0.12)', fillerColor: 'rgba(59,130,246,0.06)', handleStyle: { color: '#3b82f6' }, textStyle: { color: '#3d5278', fontSize: 9 } },
    ],
    grid: [
      { left: 60, right: 14, top: 8, height: '42%' },
      { left: 60, right: 14, top: '55%', height: '10%' },
      { left: 60, right: 14, top: '69%', height: '10%' },
      { left: 60, right: 14, top: '83%', height: '10%' },
    ],
    xAxis: [
      { gridIndex: 0, data: dates, axisLine: { lineStyle: { color: 'rgba(59,130,246,0.06)' } }, axisLabel: { show: false } },
      { gridIndex: 1, data: dates, axisLine: { lineStyle: { color: 'rgba(59,130,246,0.06)' } }, axisLabel: { show: false } },
      { gridIndex: 2, data: dates, axisLine: { lineStyle: { color: 'rgba(59,130,246,0.06)' } }, axisLabel: { show: false } },
      { gridIndex: 3, data: dates, axisLine: { lineStyle: { color: 'rgba(59,130,246,0.06)' } }, axisLabel: { color: '#3d5278', fontSize: 9 } },
    ],
    yAxis: [
      { scale: true, gridIndex: 0, axisLabel: { color: '#3d5278', fontSize: 9, formatter: v => v.toFixed(2) }, splitLine: { lineStyle: { color: 'rgba(59,130,246,0.04)', type: 'dashed' } } },
      { scale: true, gridIndex: 1, axisLabel: { color: '#3d5278', fontSize: 8 }, splitLine: { show: false } },
      { scale: true, gridIndex: 2, axisLabel: { color: '#3d5278', fontSize: 8 }, splitLine: { show: false } },
      { min: 0, max: 100, gridIndex: 3, axisLabel: { color: '#3d5278', fontSize: 8 }, splitLine: { show: false }, splitNumber: 3 },
    ],
    series: [
      { name: 'K线', type: 'candlestick', xAxisIndex: 0, yAxisIndex: 0, data: candles,
        itemStyle: { color: '#00e96a', color0: '#ff3d6a', borderColor: '#00e96a', borderColor0: '#ff3d6a', borderWidth: 1 },
        emphasis: { itemStyle: { shadowBlur: 14, shadowColor: 'rgba(59,130,246,0.5)', borderWidth: 2 } },
      },
      { name: 'BOLL上轨', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: boll.upper, symbol: 'none', silent: true, lineStyle: { width: 0.8, color: 'rgba(255,61,106,0.25)', type: 'dashed' }, tooltip: { show: false } },
      { name: 'BOLL中轨', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: boll.mid, symbol: 'none', silent: true, lineStyle: { width: 0.8, color: 'rgba(255,255,255,0.2)' }, tooltip: { show: false } },
      { name: 'BOLL下轨', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: boll.lower, symbol: 'none', silent: true, lineStyle: { width: 0.8, color: 'rgba(0,233,106,0.25)', type: 'dashed' }, tooltip: { show: false } },
      { name: 'MA5', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: ma5, smooth: 0.3, symbol: 'none', lineStyle: { width: 1.2, color: '#f59e0b' }, tooltip: { show: false } },
      { name: 'MA10', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: ma10, smooth: 0.3, symbol: 'none', lineStyle: { width: 1.2, color: '#3b82f6' }, tooltip: { show: false } },
      { name: 'MA20', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: ma20, smooth: 0.3, symbol: 'none', lineStyle: { width: 1.2, color: '#a855f7' }, tooltip: { show: false } },
      { name: 'MA60', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: ma60, smooth: 0.3, symbol: 'none', lineStyle: { width: 1, color: 'rgba(255,61,106,0.5)', type: 'dotted' }, tooltip: { show: false } },
      { name: 'EMA12', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: ema12, smooth: 0.5, symbol: 'none', silent: true, lineStyle: { width: 0.8, color: 'rgba(0,233,106,0.35)' }, tooltip: { show: false } },
      { name: 'EMA26', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: ema26, smooth: 0.5, symbol: 'none', silent: true, lineStyle: { width: 0.8, color: 'rgba(255,61,106,0.3)' }, tooltip: { show: false } },
      { name: 'BBI', type: 'line', xAxisIndex: 0, yAxisIndex: 0, data: bbi, symbol: 'none', lineStyle: { width: 1.5, color: '#06b6d4' }, tooltip: { show: false } },
      { name: '成交量', type: 'bar', xAxisIndex: 1, yAxisIndex: 1, data: volumes, barMaxWidth: 8 },
      { name: 'VOL5', type: 'line', xAxisIndex: 1, yAxisIndex: 1, data: vol5, symbol: 'none', silent: true, lineStyle: { width: 1, color: '#f59e0b' }, tooltip: { show: false } },
      { name: 'VOL10', type: 'line', xAxisIndex: 1, yAxisIndex: 1, data: vol10, symbol: 'none', silent: true, lineStyle: { width: 1, color: '#a855f7' }, tooltip: { show: false } },
      { name: 'DIF', type: 'line', xAxisIndex: 2, yAxisIndex: 2, data: dif.map(v => typeof v === 'number' ? +v.toFixed(4) : v), smooth: 0.2, symbol: 'none', lineStyle: { width: 1, color: '#3b82f6' } },
      { name: 'DEA', type: 'line', xAxisIndex: 2, yAxisIndex: 2, data: dea.map(v => typeof v === 'number' ? +v.toFixed(4) : v), smooth: 0.2, symbol: 'none', lineStyle: { width: 1, color: '#f59e0b' } },
      { name: 'MACD', type: 'bar', xAxisIndex: 2, yAxisIndex: 2,
        data: hist.map(v => { const n = typeof v === 'number' ? v : parseFloat(v) || 0; return { value: +n.toFixed(4), itemStyle: { color: n >= 0 ? new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: 'rgba(0,233,106,0.8)' }, { offset: 1, color: 'rgba(0,233,106,0.15)' }]) : new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: 'rgba(255,61,106,0.15)' }, { offset: 1, color: 'rgba(255,61,106,0.8)' }]) } }; }), barMaxWidth: 6 },
      { name: 'RSI14', type: 'line', xAxisIndex: 3, yAxisIndex: 3, data: rsi14, symbol: 'none', lineStyle: { width: 1.5, color: '#06b6d4' },
        markLine: { silent: true, symbol: 'none', lineStyle: { color: 'rgba(255,255,255,0.12)', type: 'dashed' },
          data: [{ yAxis: 70, label: { formatter: '超买 70', color: '#ff3d6a', fontSize: 8 } }, { yAxis: 30, label: { formatter: '超卖 30', color: '#00e96a', fontSize: 8 } }, { yAxis: 50, label: { formatter: '50', color: '#8b9ec2', fontSize: 8 } }] },
        areaStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: 'rgba(6,182,212,0.15)' }, { offset: 1, color: 'rgba(6,182,212,0.02)' }]) } },
    ],
    legend: { data: ['MA5', 'MA10', 'MA20', 'MA60', 'BBI', 'BOLL'], top: 4, right: 14, textStyle: { color: '#3d5278', fontSize: 10 }, itemWidth: 14, itemHeight: 2, icon: 'roundRect', itemGap: 10 },
  }, { notMerge: true, lazyUpdate: false });
}

/**
 * 调整 K 线图尺寸
 */
function resizeKline() {
  if (klineChart && !klineChart.isDisposed()) {
    klineChart.resize();
  }
  if (window.appState && window.appState.radarChart && !window.appState.radarChart.isDisposed()) {
    window.appState.radarChart.resize();
  }
}

/**
 * 实时更新 K 线最后一根蜡烛的收盘价（交易时段实时行情）
 * @param {number} price - 实时价格
 * @param {number} high - 实时最高价
 * @param {number} low - 实时最低价
 * @param {number} volume - 实时成交量
 */
function updateLastCandle(price, high, low, volume) {
  if (!klineChart || klineChart.isDisposed()) return;
  if (chartType !== 'kline') return;

  var option = klineChart.getOption();
  if (!option || !option.series || !option.series[0] || !option.series[0].data) return;

  var data = option.series[0].data;
  if (!data || data.length === 0) return;

  var lastIdx = data.length - 1;
  var last = data[lastIdx];
  if (!last || !Array.isArray(last)) return;

  // 更新收盘价、最高价、最低价
  if (last.length >= 4) {
    if (price > 0) last[1] = +price.toFixed(2);  // 收盘价
    if (high > 0) last[3] = +high.toFixed(2);    // 最高价
    if (low > 0) last[2] = +low.toFixed(2);       // 最低价
  }

  // 更新成交量柱
  if (volume > 0 && option.series[11]) {
    var volData = option.series[11].data;
    if (volData && volData.length > 0) {
      var lastVol = volData[lastIdx];
      var isUp = data[lastIdx][1] >= data[lastIdx][0];
      if (lastVol && typeof lastVol === 'object') {
        lastVol.value = volume;
        lastVol.itemStyle = {
          color: isUp
            ? new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                { offset: 0, color: 'rgba(0,233,106,0.55)' },
                { offset: 1, color: 'rgba(0,233,106,0.1)' },
              ])
            : new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                { offset: 0, color: 'rgba(255,61,106,0.55)' },
                { offset: 1, color: 'rgba(255,61,106,0.1)' },
              ]),
        };
      }
    }
  }

  // candle 颜色随涨跌更新
  if (data[lastIdx].length >= 4) {
    var o = data[lastIdx][0], c = data[lastIdx][1];
    var itemStyle = option.series[0].itemStyle || {};
    if (c >= o) {
      data[lastIdx].itemStyle = { color: '#00e96a', borderColor: '#00e96a' };
    } else {
      data[lastIdx].itemStyle = { color: '#ff3d6a', borderColor: '#ff3d6a' };
    }
  }

  // 静默更新，不触发动画
  klineChart.setOption(option, { notMerge: false, lazyUpdate: true, silent: true });
}

window.updateLastCandle = updateLastCandle;

function showToast(title, body) {
  try { if (typeof window.showAppToast === 'function') window.showAppToast(title, body); } catch (e) { console.log(title, body); }
}
/**
 * DAPENG Alpha 策略选股系统 - 策略面板 UI 更新 v3
 *
 * v3.0 升级：
 * - 评分数字发光动效
 * - 策略条渐变发光
 * - K线形态标签入场动画
 * - 铁律通过/警告动态颜色
 * - 仓位环形指示器
 * - AI面板展示布林带/KDJ/多时间框架/风险量化/操作建议
 */

// ================================================================
//  K 线形态识别
// ================================================================
function detectCandlePatterns(klines) {
  if (!klines || klines.length < 5) return [];

  const patterns = [];
  const last = klines[klines.length - 1];
  const prev = klines[klines.length - 2];

  const body = Math.abs(last.c - last.o);
  const upperShadow = last.h - Math.max(last.c, last.o);
  const lowerShadow = Math.min(last.c, last.o) - last.l;
  const totalRange = last.h - last.l;
  const isUp = last.c > last.o;
  const isDown = last.c < last.o;

  if (totalRange > 0 && body / totalRange < 0.1 && upperShadow > body * 2 && lowerShadow > body * 2) {
    patterns.push({ name: '十字星', type: 'neutral', desc: '多空平衡，变盘信号', icon: '✦' });
  }
  if (isDown && lowerShadow > body * 2 && upperShadow < body * 0.5) {
    patterns.push({ name: '锤子线', type: 'bullish', desc: '下跌中见底信号', icon: '🔨' });
  }
  if (isDown && upperShadow > body * 2 && lowerShadow < body * 0.5 && prev.c < prev.o) {
    patterns.push({ name: '倒锤子', type: 'bullish', desc: '可能反转上涨', icon: '⤴' });
  }
  if (isUp && upperShadow > body * 2 && lowerShadow < body * 0.5 && prev.c > prev.o) {
    patterns.push({ name: '射击之星', type: 'bearish', desc: '上涨受阻，见顶信号', icon: '⤵' });
  }
  if (prev && isUp && last.c > prev.o && last.o < prev.c) {
    patterns.push({ name: '看涨吞没', type: 'bullish', desc: '强力反转上涨信号', icon: '⬆' });
  }
  if (prev && isDown && last.o > prev.c && last.c < prev.o) {
    patterns.push({ name: '看跌吞没', type: 'bearish', desc: '反转下跌信号', icon: '⬇' });
  }
  const avgBody = klines.slice(-10).reduce((s, k) => s + Math.abs(k.c - k.o), 0) / 10;
  if (isUp && body > avgBody * 2) {
    patterns.push({ name: '大阳线', type: 'bullish', desc: '多方强势', icon: '🟢' });
  }
  if (isDown && body > avgBody * 2) {
    patterns.push({ name: '大阴线', type: 'bearish', desc: '空方强势', icon: '📭' });
  }
  if (klines.length >= 3) {
    const last3 = klines.slice(-3);
    if (last3.every(k => k.c > k.o)) {
      patterns.push({ name: '三连阳', type: 'bullish', desc: '连续上涨', icon: '📈' });
    }
    if (last3.every(k => k.c < k.o)) {
      patterns.push({ name: '三连阴', type: 'bearish', desc: '连续下跌', icon: '📉' });
    }
  }

  return patterns;
}

// ================================================================
//  策略面板更新
// ================================================================
function updateStrategyPanel(strategyData, klineData) {
  if (!strategyData) return;

  const signals = strategyData.signals || [];
  const momentumSignal = signals.find(s => s.type === 'momentum');
  const breakoutSignal = signals.find(s => s.type === 'breakout');
  const volumeSignal = signals.find(s => s.type === 'volume_divergence');

  const mScore = momentumSignal ? momentumSignal.score : 50;
  const mDesc = momentumSignal ? momentumSignal.desc : '中性';
  const bScore = breakoutSignal ? breakoutSignal.score : 50;
  const bDesc = breakoutSignal ? breakoutSignal.desc : '区间震荡';
  const vScore = volumeSignal ? volumeSignal.score : 50;
  const vDesc = volumeSignal ? volumeSignal.desc : '量能一般';

  // 动量策略
  animateScore('s-momentum', mScore);
  const mDescEl = document.getElementById('s-momentum-desc');
  const mBarEl = document.getElementById('s-m-bar');
  if (mDescEl) mDescEl.textContent = mDesc;
  if (mBarEl) {
    mBarEl.style.width = mScore + '%';
    mBarEl.style.background = mScore >= 70 ? 'linear-gradient(90deg,rgba(245,158,11,0.8),rgba(0,233,106,0.9))' :
                               mScore >= 50 ? 'linear-gradient(90deg,rgba(59,130,246,0.7),rgba(245,158,11,0.8))' :
                               'linear-gradient(90deg,rgba(255,61,106,0.7),rgba(245,158,11,0.6))';
  }

  // 突破策略
  animateScore('s-break', bScore);
  const bDescEl = document.getElementById('s-break-desc');
  const bBarEl = document.getElementById('s-b-bar');
  if (bDescEl) bDescEl.textContent = bDesc;
  if (bBarEl) {
    bBarEl.style.width = bScore + '%';
    bBarEl.style.background = bScore >= 70 ? 'linear-gradient(90deg,rgba(6,182,212,0.8),rgba(0,233,106,0.9))' :
                               bScore >= 50 ? 'linear-gradient(90deg,rgba(59,130,246,0.7),rgba(6,182,212,0.8))' :
                               'linear-gradient(90deg,rgba(255,61,106,0.7),rgba(6,182,212,0.6))';
  }

  // 量价策略
  animateScore('s-vol', vScore);
  const vDescEl = document.getElementById('s-vol-desc');
  const vBarEl = document.getElementById('s-v-bar');
  if (vDescEl) vDescEl.textContent = vDesc;
  if (vBarEl) {
    vBarEl.style.width = vScore + '%';
    vBarEl.style.background = vScore >= 65 ? 'linear-gradient(90deg,rgba(168,85,247,0.8),rgba(0,233,106,0.9))' :
                               vScore >= 50 ? 'linear-gradient(90deg,rgba(168,85,247,0.7),rgba(59,130,246,0.8))' :
                               'linear-gradient(90deg,rgba(255,61,106,0.7),rgba(168,85,247,0.6))';
  }

  // 综合评分
  const avgScore = Math.round(mScore * 0.35 + bScore * 0.3 + vScore * 0.35);

  // 仓位建议
  const strategyInfo = klineData ? klineData.strategy : null;
  const posPct = strategyInfo ? strategyInfo.position_pct : Math.round(avgScore * 0.4 + 10);
  const stopLoss = strategyInfo ? strategyInfo.stop_loss : 0;

  const posPctEl = document.getElementById('pos-pct');
  const posDescEl = document.getElementById('pos-desc');
  const posBarEl = document.getElementById('pos-bar');

  if (posPctEl) {
    posPctEl.textContent = posPct + '%';
    posPctEl.className = 'mini-val ' + (posPct > 30 ? 'up' : 'flat');
  }
  if (posDescEl) {
    let descText = `综合 ${avgScore}`;
    if (stopLoss > 0) {
      descText += ` | 止损 ${stopLoss.toFixed(2)}`;
    }
    posDescEl.textContent = descText;
  }
  if (posBarEl) {
    posBarEl.style.width = Math.min(posPct * 1.25, 100) + '%';
  }

  // K 线形态识别
  const klines = klineData ? klineData.klines : null;
  const patterns = detectCandlePatterns(klines);
  const patternEl = document.getElementById('pattern-panel');
  if (patternEl && patterns.length > 0) {
    patternEl.innerHTML = patterns.map((p, i) => {
      const cls = p.type === 'bullish' ? 'ai-tag-success' :
                  p.type === 'bearish' ? 'ai-tag-error' : 'ai-tag-warning';
      return `<div class="ai-tag ${cls}" title="${p.desc}" style="animation:fadeIn .3s ease-out ${i * 80}ms both;opacity:0">${p.icon || ''} ${p.name}</div>`;
    }).join('');
  } else if (patternEl) {
    patternEl.innerHTML = '<span style="font-size:10px;color:var(--muted)">无明显形态</span>';
  }

  // 信号提示
  if (mScore > 75 && bScore > 75) {
    const name = window.appState ? window.appState.activeName : '';
    showToast('⚡ 买入信号', `${name} 动量+突破双强，评分 ${avgScore}`);
  }

  const bullishPatterns = patterns.filter(p => p.type === 'bullish');
  if (bullishPatterns.length >= 2) {
    const name = window.appState ? window.appState.activeName : '';
    showToast('📈 K线形态', `${name} 出现 ${bullishPatterns.map(p=>p.name).join('+')}`);
  }

  // ===== v4.0 新增：展示6大战法评分 =====
  const combinedScore = strategyData.combined_score || 0;
  const tacticScores = [
    { key: 'ma_bullish', label: '多头排列', score: strategyData.ma_bullish_score || 0 },
    { key: 'pullback', label: '强势回调', score: strategyData.pullback_score || 0 },
    { key: 'limit_up', label: '涨停战法', score: strategyData.limit_up_score || 0 },
    { key: 'bottom_reversal', label: '底部反转', score: strategyData.bottom_reversal_score || 0 },
    { key: 'dragon_head', label: '龙头战法', score: strategyData.dragon_head_score || 0 },
    { key: 'momentum_reversal', label: '动量反转', score: strategyData.momentum_reversal_score || 0 },
  ];

  const tacticEl = document.getElementById('tactics-panel');
  if (tacticEl) {
    tacticEl.innerHTML = tacticScores.map((t, i) => {
      const color = t.score >= 70 ? 'var(--green)' : t.score >= 50 ? 'var(--gold)' : 'var(--red)';
      const bg = t.score >= 70 ? 'rgba(0,233,106,0.1)' : t.score >= 50 ? 'rgba(245,158,11,0.1)' : 'rgba(255,61,106,0.1)';
      return `<div style="display:flex;justify-content:space-between;align-items:center;padding:2px 0;font-size:10px;animation:fadeIn .2s ease-out ${i*40}ms both;opacity:0">
        <span style="color:var(--text2)">${t.label}</span>
        <span style="color:${color};font-weight:600;font-family:'Courier New',monospace">${t.score}</span>
      </div>`;
    }).join('') + `
      <div style="margin-top:4px;padding-top:4px;border-top:1px solid rgba(255,255,255,0.04);display:flex;justify-content:space-between;align-items:center">
        <span style="font-size:9px;color:var(--muted)">综合战法评分</span>
        <span id="combined-score" style="font-size:13px;font-weight:700;font-family:'Courier New',monospace;color:${combinedScore>=70?'var(--green)':combinedScore>=50?'var(--gold)':'var(--red)'}">${combinedScore}</span>
      </div>`;
  }
}

// ================================================================
//  铁律检测
// ================================================================
function updateLaws(stockData, klineData) {
  const el = document.getElementById('laws-grid');
  if (!el) return;

  const chg = stockData ? (stockData.chg || 0) : 0;
  const price = stockData ? (stockData.price || 0) : 0;
  const strategy = klineData ? klineData.strategy : null;
  const klines = klineData ? klineData.klines : null;

  const laws = [
    { label: '趋势向上', pass: chg > 0 },
    { label: '量能充裕', pass: (stockData && stockData.volume && stockData.volume > 0) ? true : false },
    { label: '止损明确', pass: strategy && strategy.stop_loss > 0 && price > strategy.stop_loss },
    { label: 'MA金叉', pass: strategy && strategy.ma_cross === 'gold' },
    { label: '未超买', pass: !strategy || !strategy.rsi || strategy.rsi < 70 },
    { label: '形态偏多', pass: (() => {
      const patterns = detectCandlePatterns(klines);
      return patterns.filter(p => p.type === 'bullish').length > patterns.filter(p => p.type === 'bearish').length;
    })() },
  ];

  const passCount = laws.filter(l => l.pass).length;

  el.innerHTML = laws.map((l, i) => `
    <div style="display:flex;align-items:center;gap:5px;font-size:10px;padding:1px 0;animation:fadeIn .25s ease-out ${i * 50}ms both;opacity:0">
      <span style="width:14px;height:14px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:8px;
        background:${l.pass ? 'rgba(0,233,106,0.12)' : 'rgba(255,61,106,0.12)'};
        color:${l.pass ? 'var(--green)' : 'var(--red)'};
        border:1px solid ${l.pass ? 'rgba(0,233,106,0.2)' : 'rgba(255,61,106,0.2)'};
        transition:all .3s">${l.pass ? '✓' : '✗'}</span>
      <span style="color:var(--text2)">${l.label}</span>
      <span style="color:${l.pass ? 'var(--green)' : 'var(--red)'};margin-left:auto;font-weight:500">${l.pass ? '通过' : '警示'}</span>
    </div>
  `).join('') + `
    <div style="margin-top:4px;padding-top:4px;border-top:1px solid rgba(255,255,255,0.04);display:flex;align-items:center;justify-content:space-between">
      <span style="font-size:9px;color:var(--muted)">铁律通过率</span>
      <div style="display:flex;align-items:center;gap:4px">
        <div style="width:60px;height:3px;background:rgba(255,255,255,0.04);border-radius:2px;overflow:hidden">
          <div style="height:100%;width:${passCount/laws.length*100}%;border-radius:2px;background:linear-gradient(90deg,${passCount>=4?'var(--green)':passCount>=2?'var(--gold)':'var(--red)'},${passCount>=4?'var(--cyan)':'var(--gold)'});transition:width .6s cubic-bezier(0.34,1.56,0.64,1)"></div>
        </div>
        <span style="font-size:10px;font-weight:600;color:${passCount>=4?'var(--green)':passCount>=2?'var(--gold)':'var(--red)'}">${passCount}/${laws.length}</span>
      </div>
    </div>
  `;
}

// ================================================================
//  评分动画
// ================================================================
function animateScore(id, target) {
  const el = document.getElementById(id);
  if (!el) return;
  let current = parseInt(el.textContent) || 0;
  const step = (target - current) / 15;
  if (Math.abs(step) < 0.5) {
    el.textContent = target;
    applyScoreGlow(el, target);
    return;
  }
  const timer = setInterval(() => {
    current += step;
    if ((step > 0 && current >= target) || (step < 0 && current <= target)) {
      current = target;
      clearInterval(timer);
      applyScoreGlow(el, target);
    }
    el.textContent = Math.round(current);
  }, 20);
}

function applyScoreGlow(el, score) {
  const color = score >= 70 ? 'var(--green)' : score >= 50 ? 'var(--gold)' : 'var(--red)';
  const glowColor = score >= 70 ? 'rgba(0,233,106,0.3)' : score >= 50 ? 'rgba(245,158,11,0.3)' : 'rgba(255,61,106,0.3)';
  el.style.color = color;
  el.style.textShadow = `0 0 8px ${glowColor}`;
}

// ================================================================
//  AI 分析总结面板 — v3.0 增强版
// ================================================================
function updateAnalysisPanel(data) {
  const panel = document.getElementById('analysis-panel');
  if (!panel || !data) return;

  // 安全地转义所有 AI 生成的文本内容
  const et = s => escapeHtml(s);
  const safeTrend = et(data.trend || '分析中');
  const safeRisk = et(data.risk_level || '未知');
  const safeAction = et(data.action || '观望');
  const safeSummary = et(data.summary || '');

  const trendColor = safeTrend.includes('涨') ? 'var(--green)' :
                     safeTrend.includes('跌') ? 'var(--red)' : 'var(--gold)';
  const riskColor = safeRisk === '高风险' ? 'var(--red)' :
                    safeRisk === '中风险' ? 'var(--gold)' : 'var(--green)';
  const actionColor = (safeAction.includes('买入') || safeAction.includes('积极')) ? 'var(--green)' :
                      (safeAction.includes('减仓') || safeAction.includes('离场')) ? 'var(--red)' : 'var(--gold)';

  // 支撑阻力位
  let srHtml = '';
  if (data.support_resistance && data.support_resistance.length > 0) {
    srHtml = data.support_resistance.slice(0, 5).map(sr => {
      const isResistance = sr.type === '阻力';
      const isStop = sr.type === '止损';
      const color = isResistance ? 'var(--red)' : isStop ? '#f59e0b' : 'var(--green)';
      return `<div style="display:flex;justify-content:space-between;align-items:center;padding:2px 0;font-size:10px">
        <span style="color:${color}">${et(sr.type)}${sr.strength ? '(' + et(sr.strength) + ')' : ''}</span>
        <span style="font-family:'Courier New',monospace;font-weight:600;color:${color}">${safeFixed(sr.price)}</span>
      </div>`;
    }).join('');
  }

  // 关键观察点
  const kpHtml = (data.key_points || []).map((kp, i) =>
    `<div style="font-size:10px;color:var(--text2);padding:1px 0;animation:fadeIn .2s ease-out ${i * 50}ms both;opacity:0">• ${et(kp)}</div>`
  ).join('');

  // 风险因素
  const riskHtml = (data.risk_factors || []).map(rf =>
    `<span class="ai-tag ai-tag-error" style="font-size:9px">${et(rf)}</span>`
  ).join('');

  // ========== v3.0 新增维度 ==========

  // 布林带
  let bollHtml = '';
  if (data.boll && data.boll.upper > 0) {
    const bollPos = data.boll.position;
    const bollColor = bollPos > 0.8 ? 'var(--red)' : bollPos > 0.5 ? 'var(--gold)' : 'var(--green)';
    bollHtml = `
      <div style="border-top:1px solid rgba(255,255,255,0.03);padding-top:4px;margin-top:4px">
        <div style="font-size:9px;color:var(--muted);margin-bottom:2px">布林带 BOLL(20,2)</div>
        <div style="display:flex;gap:8px;font-size:10px;margin-bottom:2px">
          <span style="color:var(--red)">上轨 ${data.boll.upper}</span>
          <span style="color:var(--gold)">中轨 ${data.boll.mid}</span>
          <span style="color:var(--green)">下轨 ${data.boll.lower}</span>
        </div>
        <div style="display:flex;align-items:center;gap:6px">
          <div style="flex:1;height:4px;background:rgba(255,255,255,0.04);border-radius:2px;overflow:hidden;position:relative">
            <div style="position:absolute;left:${bollPos * 100}%;top:-2px;width:3px;height:8px;background:${bollColor};border-radius:2px;transform:translateX(-50%)"></div>
          </div>
          <span style="font-size:9px;color:${bollColor}">${et(data.boll.signal)}</span>
        </div>
      </div>
    `;
  }

  // KDJ
  let kdjHtml = '';
  if (data.kdj) {
    const kdjK = data.kdj.k;
    const kdjColor = kdjK > 80 ? 'var(--red)' : kdjK < 20 ? 'var(--green)' : 'var(--gold)';
    kdjHtml = `
      <div style="display:flex;gap:6px;align-items:center;font-size:10px;margin-top:4px">
        <span style="color:var(--muted)">KDJ</span>
        <span style="color:${kdjColor};font-weight:600">K=${data.kdj.k}</span>
        <span style="color:var(--text2)">D=${data.kdj.d}</span>
        <span style="color:var(--text2)">J=${data.kdj.j}</span>
        <span style="font-size:9px;color:${kdjColor};margin-left:auto">${et(data.kdj.signal)}</span>
      </div>
    `;
  }

  // MACD详细
  let macdDetailHtml = '';
  if (data.macd_detail) {
    const md = data.macd_detail;
    macdDetailHtml = `
      <div style="display:flex;gap:6px;align-items:center;font-size:10px;margin-top:3px">
        <span style="color:var(--muted)">MACD</span>
        <span style="color:var(--text2)">${et(md.trend)}</span>
        <span style="font-size:9px;color:var(--gold);margin-left:auto">${et(md.signal)}</span>
      </div>
    `;
  }

  // 多时间框架
  let mtfHtml = '';
  if (data.multi_timeframe) {
    const mtf = data.multi_timeframe;
    const overallColor = mtf.overall === '多头趋势' ? 'var(--green)' :
                         mtf.overall === '空头趋势' ? 'var(--red)' : 'var(--gold)';
    mtfHtml = `
      <div style="display:flex;gap:6px;align-items:center;font-size:10px;margin-top:3px">
        <span style="color:var(--muted)">周期</span>
        <span style="font-size:9px;color:var(--text2)">短${et(mtf.short)}</span>
        <span style="font-size:9px;color:var(--text2)">中${et(mtf.mid)}</span>
        <span style="font-size:9px;color:var(--text2)">长${et(mtf.long)}</span>
        <span style="font-size:10px;font-weight:600;color:${overallColor};margin-left:auto">${et(mtf.overall)}</span>
      </div>
    `;
  }

  // 风险量化
  let riskQuantHtml = '';
  if (data.risk_quant) {
    const rq = data.risk_quant;
    riskQuantHtml = `
      <div style="display:flex;gap:8px;font-size:9px;margin-top:3px;color:var(--text2)">
        <span>跌回撤${rq.max_drawdown}%</span>
        <span>基波动${rq.volatility}%</span>
        <span>!VaR95=${rq.var_95}%</span>
      </div>
    `;
  }

  // 操作建议精细化
  let actionDetailHtml = '';
  if (data.action_detail) {
    const ad = data.action_detail;
    actionDetailHtml = `
      <div style="border-top:1px solid rgba(255,255,255,0.03);padding-top:4px;margin-top:4px">
        <div style="font-size:9px;color:var(--muted);margin-bottom:3px">操作建议</div>
        <div style="display:flex;gap:8px;font-size:10px;margin-bottom:2px">
          <span style="color:var(--green)">买入区间 ${ad.buy_zone}</span>
        </div>
        <div style="display:flex;gap:8px;font-size:10px;margin-bottom:2px">
          <span style="color:var(--gold)">止盈1 ${ad.stop_profit_1}</span>
          <span style="color:var(--gold)">止盈2 ${ad.stop_profit_2}</span>
        </div>
        <div style="font-size:10px;color:var(--text2)">基 ${et(ad.batch_strategy)}</div>
      </div>
    `;
  }

  // ========== v4.0 DeepSeek AI 决策引擎 ==========
  let aiDecisionHtml = '';
  if (data.ai_decision) {
    const ai = data.ai_decision;
    const safeAiDecision = et(ai.decision || '观望');
    const safeAiSummary = et(ai.summary || '');
    const safeAiTiming = et(ai.timing || '中线');
    const safeAiTrend = et(ai.trend_judgment || '--');
    const safeAiRiskAlert = et(ai.risk_alert || '');
    const safeAiKeyReason = et(ai.key_reason || '');

    const decisionColor = safeAiDecision === '买入' ? 'var(--green)' :
                          safeAiDecision === '卖出' ? 'var(--red)' :
                          safeAiDecision === '持有' ? 'var(--cyan)' : 'var(--gold)';
    const decisionBg = safeAiDecision === '买入' ? 'rgba(0,233,106,0.08)' :
                       safeAiDecision === '卖出' ? 'rgba(255,61,106,0.08)' :
                       safeAiDecision === '持有' ? 'rgba(6,182,212,0.08)' : 'rgba(245,158,11,0.08)';
    const confidenceColor = (ai.confidence || 0) >= 75 ? 'var(--green)' :
                           (ai.confidence || 0) >= 50 ? 'var(--gold)' : 'var(--red)';
    const entryPrice = ai.entry_price ? `${safeFixed(ai.entry_price.low)}-${safeFixed(ai.entry_price.high)}` : '--';
    const takeProfit = ai.take_profit ? `①${safeFixed(ai.take_profit.first)} ②${safeFixed(ai.take_profit.second)}` : '--';
    const timing = safeAiTiming;
    const timingIcon = timing === '短线' ? '⚡' : timing === '长线' ? '🎯' : '📊';

    aiDecisionHtml = `
      <div style="background:${decisionBg};border:1px solid ${decisionColor}30;border-radius:8px;padding:8px 10px;margin-bottom:8px;position:relative;overflow:hidden">
        <div style="position:absolute;top:-10px;right:-5px;font-size:40px;opacity:0.06;transform:rotate(15deg)">AI</div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="font-size:10px;color:var(--muted)">DeepSeek AI 决策</span>
            <span style="font-size:15px;font-weight:800;color:${decisionColor};text-shadow:0 0 12px ${decisionColor}40">${safeAiDecision}</span>
          </div>
          <div style="display:flex;align-items:center;gap:4px">
            <span style="font-size:9px;color:var(--muted)">置信度</span>
            <span style="font-size:13px;font-weight:700;font-family:'Courier New',monospace;color:${confidenceColor}">${ai.confidence || 0}%</span>
          </div>
        </div>
        <div style="font-size:10px;color:var(--text);line-height:1.5;margin-bottom:4px">${safeAiSummary}</div>
        <div style="display:flex;gap:10px;font-size:9px;margin-bottom:3px;flex-wrap:wrap">
          <span style="color:var(--green)">多入场 ${entryPrice}</span>
          <span style="color:var(--red)">空止损 ${safeFixed(ai.stop_loss)}</span>
          <span style="color:var(--gold)">观止盈 ${takeProfit}</span>
        </div>
        <div style="display:flex;gap:8px;font-size:9px;margin-bottom:3px">
          <span style="color:var(--text2)">${timingIcon}${timing}</span>
          <span style="color:var(--text2)">仓位${ai.position_pct || 0}%</span>
          <span style="color:var(--cyan)">趋势: ${safeAiTrend}</span>
        </div>
        ${safeAiRiskAlert ? `<div style="font-size:9px;color:var(--red);background:rgba(255,61,106,0.08);padding:2px 6px;border-radius:3px;margin-top:2px">! ${safeAiRiskAlert}</div>` : ''}
        ${safeAiKeyReason ? `<div style="font-size:9px;color:var(--cyan);margin-top:2px">提示 ${safeAiKeyReason}</div>` : ''}
      </div>
    `;
  }

  panel.innerHTML = `
    ${aiDecisionHtml}
    <div style="display:flex;gap:6px;margin-bottom:8px;flex-wrap:wrap">
      <div style="padding:3px 10px;border-radius:6px;background:${trendColor}15;border:1px solid ${trendColor}30;color:${trendColor};font-size:11px;font-weight:600">
        ${safeTrend}
      </div>
      <div style="padding:3px 10px;border-radius:6px;background:${riskColor}15;border:1px solid ${riskColor}30;color:${riskColor};font-size:11px;font-weight:600">
        ${safeRisk}
      </div>
      <div style="padding:3px 10px;border-radius:6px;background:${actionColor}15;border:1px solid ${actionColor}30;color:${actionColor};font-size:11px;font-weight:600">
        ${safeAction}
      </div>
    </div>
    <div style="font-size:11px;color:var(--text);line-height:1.6;margin-bottom:6px">${safeSummary}</div>
    ${riskHtml ? `<div style="display:flex;flex-wrap:wrap;gap:3px;margin-bottom:4px">${riskHtml}</div>` : ''}
    ${srHtml ? `<div style="border-top:1px solid rgba(255,255,255,0.03);padding-top:4px;margin-bottom:4px">${srHtml}</div>` : ''}
    ${bollHtml}
    ${kdjHtml}
    ${macdDetailHtml}
    ${mtfHtml}
    ${riskQuantHtml}
    ${actionDetailHtml}
    ${kpHtml ? `<div style="border-top:1px solid rgba(255,255,255,0.03);padding-top:4px;margin-top:4px">${kpHtml}</div>` : ''}
  `;
  panel.style.display = 'block';
}

// ================================================================
//  全球情绪面板
// ================================================================
function updateGlobalPanel(data) {
  if (!data) return;

  const panel = document.getElementById('global-panel');
  if (!panel) return;

  const items = [];

  if (data.overseas) {
    if (data.overseas.gold) {
      items.push({ key: 'gold', d: data.overseas.gold, label: '黄金' });
    }
    if (data.overseas.ndx) {
      items.push({ key: 'ndx', d: data.overseas.ndx, label: '纳指' });
    }
  }

  panel.innerHTML = items.map(i => {
    const d = i.d;
    if (!d) return '';
    const chg = d.chg || 0;
    const cls = chg > 0 ? 'up' : chg < 0 ? 'dn' : 'flat';
    const sign = chg > 0 ? '+' : '';
    const arrow = chg > 0 ? '▲' : chg < 0 ? '▼' : '—';
    return `
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span style="font-size:10px;color:var(--text2)">${d.name || i.label}</span>
        <span class="${cls}" style="font-size:11px;font-weight:600;font-family:'Courier New',monospace">${arrow} ${sign}${chg.toFixed(2)}%</span>
      </div>
    `;
  }).join('');

  if (data.overseas) {
    const nd = data.overseas.ndx;
    const gc = data.overseas.gold;

    if (nd) {
      const sign = nd.chg > 0 ? '+' : '';
      const cls = nd.chg > 0 ? 'up' : nd.chg < 0 ? 'dn' : 'flat';
      const ndPEl = document.getElementById('nd-p');
      const ndCEl = document.getElementById('nd-c');
      if (ndPEl) ndPEl.textContent = (nd.price || 0).toFixed(0);
      if (ndCEl) {
        ndCEl.textContent = sign + (nd.chg || 0).toFixed(2) + '%';
        ndCEl.className = 'idx-chg ' + cls;
      }
    }
    if (gc) {
      const sign = gc.chg > 0 ? '+' : '';
      const cls = gc.chg > 0 ? 'up' : gc.chg < 0 ? 'dn' : 'flat';
      const gcPEl = document.getElementById('gc-p');
      const gcCEl = document.getElementById('gc-c');
      if (gcPEl) gcPEl.textContent = (gc.price || 0).toFixed(0);
      if (gcCEl) {
        gcCEl.textContent = sign + (gc.chg || 0).toFixed(2) + '%';
        gcCEl.className = 'idx-chg ' + cls;
      }
    }
  }
}
